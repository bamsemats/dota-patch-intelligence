{
  "name": "dota-patch-intelligence",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "inspect:steam-news": "tsx apps/scripts/inspectSteamNews.ts",
    "patch:discovery": "tsx apps/scripts/patchDiscovery.ts",
    "patch:mappings": "tsx apps/scripts/fetchMappings.ts",
    "patch:parse": "tsx apps/scripts/parsePatches.ts",
    "patch:classify": "tsx apps/scripts/classifyPatches.ts",
    "patch:analyze": "tsx apps/scripts/analyzePatch.ts",
    "patch:impact": "tsx apps/scripts/impactScorer.ts",
    "patch:meta": "tsx apps/scripts/metaAnalyzer.ts",
    "patch:meta-backfill": "tsx apps/scripts/backfillMeta.ts",
    "patch:meta-check": "tsx apps/scripts/factChecker.ts",
    "patch:review": "tsx apps/scripts/reviewUnknowns.ts",
    "patch:vectors": "tsx apps/scripts/calculateVectors.ts",
    "patch:simulate": "tsx apps/scripts/simulateMeta.ts",
    "patch:validate": "tsx apps/scripts/validateEngine.ts",
    "patch:fetch-winrates": "tsx apps/scripts/fetchOpenDotaWinrates.ts",
    "patch:calibrate": "tsx apps/scripts/calibrateWeights.ts",
    "patch:generate-history": "tsx apps/scripts/generateHeroHistory.ts && tsx apps/scripts/generateItemHistory.ts",
    "db:seed": "tsx apps/api/seed.ts",
    "db:backup": "tsx apps/scripts/backupDb.ts",
    "predb:seed": "npm run db:backup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamsemats/dota-patch-intelligence.git"
