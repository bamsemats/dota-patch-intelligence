  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@fastify/cors": "^11.2.0",
    "@google/genai": "^2.8.0",
    "create-next-app": "^16.2.7",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-cors": "^6.0.3"
  },
